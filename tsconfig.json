{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "typeRoots": [
      "./node_modules/@types",
      "./backend/node_modules/@types",
      "./frontend/node_modules/@types"
    ]
  },
  "include": ["api/**/*", "backend/src/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}
