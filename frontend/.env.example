# ===================================================
# YEZ BEE FASHION - Frontend Environment Variables
# ===================================================

# Public API URL
# Development: http://localhost:5000/api/v1 (or leave blank to use relative /api/v1)
# Production: https://api.yezbee.com/api/v1 (or leave blank to use relative /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Cloudinary Public Cloud Name (Safe for browser bundle)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=smpyi8aw

# NOTE: Do NOT add private secrets (MONGODB_URI, JWT_SECRET, CLOUDINARY_API_SECRET, RAZORPAY_KEY_SECRET) here.
# Private secrets belong exclusively in backend environment configuration.
