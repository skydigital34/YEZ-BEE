{
  "framework": "nextjs",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "functions": {
    "api/index.ts": {
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    }
  ]
}
